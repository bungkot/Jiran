# Salin menjadi .env lalu sesuaikan
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
# Optional absolute host path for the Compose Ollama model store; default: ${HOME}/.ollama
# OLLAMA_MODELS_DIR=/data/home/.ollama
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=300
LLM_MAX_RETRIES=2
# Context window Ollama (token). MAX_CONTEXT_CHARS harus kira-kira <= 3x OLLAMA_NUM_CTX.
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=30m
MAX_CONTEXT_CHARS=40000
COMMAND_TIMEOUT_S=300
MAX_OUTPUT_CHARS=8000
MAX_FILE_BYTES=200000
MAX_FIX_ITER=5
MAX_AGENT_STEPS=20
MAX_AGENT_TOOL_CALLS=40
MAX_GOAL_ITER=9
GOAL_STUCK_LIMIT=2
AGENT_CONTAINER_IMAGE=coding-agent:local
CONTAINER_GOAL_TIMEOUT_S=900
AGENT_CONTAINER_DOCKER_SOCKET=true
AGENT_CONTAINER_NETWORK=host
AGENT_SERVICE_HOST=127.0.0.1
AGENT_SERVICE_PORT=8765
AGENT_SERVICE_URL=http://localhost:8765
# Token bearer opsional untuk layanan standby (wajib bila port dibuka ke jaringan).
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_TOKEN=
SERVICE_SUBMIT_TIMEOUT_S=1800
SERVICE_POLL_INTERVAL_S=1
UID=1000
GID=1000
DOCKER_GID=991
AGENT_SANDBOX_IMAGE=
AGENT_SANDBOX_NETWORK=none
AGENT_SANDBOX_MEMORY_MB=4096
AGENT_SANDBOX_CPUS=2
AGENT_SANDBOX_PIDS_LIMIT=128
AGENT_LOGS_DIR=logs
