# Salin menjadi .env lalu sesuaikan
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen3.5:2b-q4_K_M
# Override for constrained Docker storage / CPU-only hosts:
# OLLAMA_IMAGE=ollama/ollama:rocm
# Optional absolute host path for the Compose Ollama model store; default: ${HOME}/.ollama
# OLLAMA_MODELS_DIR=/data/home/.ollama
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=300
LLM_MAX_RETRIES=2
# Context window Ollama (token). MAX_CONTEXT_CHARS harus kira-kira <= 3x OLLAMA_NUM_CTX.
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
MAX_CONTEXT_CHARS=12000
COMMAND_TIMEOUT_S=300
MAX_OUTPUT_CHARS=8000
MAX_FILE_BYTES=200000
MAX_FIX_ITER=3
MAX_AGENT_STEPS=15
MAX_AGENT_TOOL_CALLS=30
MAX_GOAL_ITER=5
# Batas atas mutlak MAX_GOAL_ITER (mencegah request mem-blok worker berhari-hari).
MAX_GOAL_ITER_LIMIT=50
# true = judge LLM tetap dipanggil walaupun verifikasi mesin lulus (lebih aman,
# lebih lambat). false = fast path; statusnya diekspos sebagai judge_skipped.
REQUIRE_JUDGE_ON_FAST_PATH=false
GOAL_STUCK_LIMIT=2
AGENT_CONTAINER_IMAGE=coding-agent:local
CONTAINER_GOAL_TIMEOUT_S=900
# Default false. true memberi container akses Docker daemon host (= root host).
AGENT_CONTAINER_DOCKER_SOCKET=false
AGENT_CONTAINER_NETWORK=host
AGENT_SERVICE_HOST=127.0.0.1
AGENT_SERVICE_PORT=8765
# Host CLI connects directly to the single local agent service.
AGENT_SERVICE_URL=http://localhost:8765
# ITSM web is loopback-only by default; add authentication before public exposure.
ITSM_PORT=3000
# Optional separate token for self-healing incident reports; defaults to AGENT_API_TOKEN.
ITSM_SYSTEM_TOKEN=
# Monitoring is opt-in: docker compose --profile monitoring up -d
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
# Token bearer WAJIB bila AGENT_SERVICE_HOST bukan loopback; minimal 32 karakter.
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_TOKEN=
SERVICE_SUBMIT_TIMEOUT_S=1800
SERVICE_POLL_INTERVAL_S=1
UID=1000
GID=1000
DOCKER_GID=991
AGENT_SANDBOX_IMAGE=
AGENT_SANDBOX_NETWORK=none
AGENT_SANDBOX_MEMORY_MB=256
AGENT_SANDBOX_CPUS=1
AGENT_SANDBOX_PIDS_LIMIT=128
# Tolak tulis jika ruang disk bebas di bawah nilai ini (MB). 0 = nonaktif.
AGENT_SANDBOX_MIN_FREE_DISK_MB=256
# Batasi writable layer container (MB). 0 = nonaktif. TIDAK membatasi bind mount workspace.
AGENT_SANDBOX_DISK_QUOTA_MB=0
AGENT_LOGS_DIR=logs
